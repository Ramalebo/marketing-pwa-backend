# Server Configuration
PORT=3000
NODE_ENV=production

# Database: SQLite (embedded, no external DB) or MySQL
# Set USE_SQLITE=true to use a file database inside the app (no FreeSQLDatabase needed)
USE_SQLITE=true

# MySQL (only used when USE_SQLITE is not true)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marketing_pwa
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenRouter API Key (for AI - Chatbot, Ad Generation, Hashtags)
# Get free API key at: https://openrouter.ai
# Free models available: meta-llama/llama-3.2-3b-instruct:free, google/gemini-flash-1.5:free
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# SMSProvider SMS Configuration (FREE - Unlimited messages)
# Sign up at: https://www.smsprovider.com/signup
SMS_PROVIDER_USERNAME=your-smsprovider-username
SMS_PROVIDER_PASSWORD=your-smsprovider-password
SMS_PROVIDER_SENDER=your-sender-id

# Domain Email (SMTP) – e.g. mail.dominantlogic.tech from Domains.co.za
# If set, the app uses this instead of Mailtrap for sending emails
SMTP_HOST=mail.dominantlogic.tech
SMTP_PORT=465
SMTP_USER=your-email@dominantlogic.tech
SMTP_PASSWORD=your-email-password
SMTP_SENDER_NAME=Marketing Platform

# Mailtrap (optional – only used if SMTP_HOST is not set)
# Sign up at: https://mailtrap.io | API token from Mailtrap Dashboard > API Tokens
MAILTRAP_API_TOKEN=your-mailtrap-api-token
MAILTRAP_SENDER_EMAIL=noreply@yourdomain.com
MAILTRAP_SENDER_NAME=Marketing Platform

# Facebook/Instagram API Configuration (see SOCIAL_MEDIA_SETUP.md)
# Used for: posting to Facebook Page and Instagram Business (same token)
# FACEBOOK_APP_SECRET is also used to verify Meta data-deletion callback signed_request
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Optional: for Meta compliance pages (privacy / data deletion). Defaults to your contact email.
# META_CONTACT_EMAIL=your-email@example.com
# APP_NAME=Your App Display Name
FACEBOOK_ACCESS_TOKEN=your-long-lived-page-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id

# Instagram Business Account (linked to same Facebook Page)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id

# WhatsApp Business API Configuration (Meta Business Suite or Twilio)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# Public base URL for ad images (Facebook/Instagram require public URLs)
FRONTEND_URL=https://dominantlogic.tech
