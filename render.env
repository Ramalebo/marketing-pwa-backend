# Render – Environment variables
# 1. Replace YOUR_* placeholders with your real values
# 2. In Render: Backend service → Environment → "Paste from .env" (or add each key manually)
# 3. Remove or leave commented lines you don't need

# --- Required – Core ---
NODE_ENV=production
PORT=10000
JWT_SECRET=dominantlogic-jwt-secret-change-in-production-2024
FRONTEND_URL=https://dominantlogic.tech

# --- Required – MySQL (cPanel) ---
DB_HOST=169.239.218.62
DB_PORT=3306
DB_NAME=dominan1_marketing_pwa
DB_USER=YOUR_CPANEL_MYSQL_USERNAME
DB_PASSWORD=YOUR_CPANEL_MYSQL_PASSWORD

# --- Domain email (SMTP) – optional if using Mailtrap ---
SMTP_HOST=mail.dominantlogic.tech
SMTP_PORT=465
SMTP_USER=YOUR_FULL_EMAIL@dominantlogic.tech
SMTP_PASSWORD=YOUR_EMAIL_PASSWORD
SMTP_SENDER_NAME=Marketing Platform

# --- Mailtrap (alternative to SMTP – use if you prefer testing inbox) ---
# MAILTRAP_API_TOKEN=YOUR_MAILTRAP_TOKEN
# MAILTRAP_SENDER_EMAIL=noreply@dominantlogic.tech
# MAILTRAP_SENDER_NAME=Marketing Platform

# --- OpenRouter (AI: chatbot, hashtags, ads) – optional ---
# OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# --- SMS provider – optional ---
# SMS_PROVIDER_USERNAME=YOUR_SMS_USERNAME
# SMS_PROVIDER_PASSWORD=YOUR_SMS_PASSWORD
# SMS_PROVIDER_SENDER=YOUR_SENDER_ID

# --- Meta / Facebook / WhatsApp – optional ---
# FACEBOOK_PAGE_ID=
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# META_CONTACT_EMAIL=your@email.com
# APP_NAME=Dominant Logic Marketing

# --- Do NOT set when using MySQL (cPanel) ---
# USE_SQLITE=
